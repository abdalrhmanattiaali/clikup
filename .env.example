# ========================= API Keys ========================= #

# Anthropic Claude API Key (للذكاء الاصطناعي)
# احصل على المفتاح من: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ========================= ClickUp Configuration ========================= #

# ClickUp API Token
CLICKUP_TOKEN=your-clickup-token-here

# ClickUp Team ID
CLICKUP_TEAM_ID=your-team-id-here

# ClickUp List ID
CLICKUP_LIST_ID=your-list-id-here

# ========================= Server Configuration ========================= #

# Port number
PORT=5014

# Node Environment
NODE_ENV=production

# ========================= WhatsApp Configuration ========================= #

# WhatsApp Group Name
WHATSAPP_GROUP_NAME=Click Up notification 📢

# ========================= Features Toggles ========================= #

# Enable/Disable AI Features
ENABLE_AI_COACH=true
ENABLE_BADGES=true
ENABLE_CHALLENGES=true
ENABLE_COURSE_RECOMMENDATIONS=true

# ========================= Timezone ========================= #

# Default timezone for cron jobs
TZ=Africa/Cairo

# ========================= Optional Settings ========================= #

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable debug mode
DEBUG=false
